+    @staticmethod
+    def _matrix_to_pose7(matrix: np.ndarray, *, field: str) -> np.ndarray:
+        matrix = np.asarray(matrix, dtype=np.float64)
+        if matrix.shape != (4, 4) or not np.isfinite(matrix).all():
+            raise ValueError(f"{field} must be a finite 4x4 transform, got {matrix.shape}")
+        rotation = matrix[:3, :3]
+        if not np.allclose(rotation.T @ rotation, np.eye(3), atol=1e-5, rtol=1e-5):
+            raise ValueError(f"{field} rotation is not orthonormal")
+        if not np.isclose(np.linalg.det(rotation), 1.0, atol=1e-5, rtol=1e-5):
+            raise ValueError(f"{field} rotation determinant is not +1")
+        quaternion = np.asarray(t3d.quaternions.mat2quat(rotation), dtype=np.float64)
+        if quaternion[0] < 0:
+            quaternion = -quaternion
+        return np.concatenate([matrix[:3, 3], quaternion], axis=0)

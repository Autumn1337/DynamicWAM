--- /dev/null
+++ b/envs/utils/frame_sync.py
@@ -0,0 +1,54 @@
+"""Frame-synchronous simulator clock used by interception data capture."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Callable
+
+
+@dataclass(frozen=True)
+class SceneClockSnapshot:
+    step_index: int
+    time_seconds: float
+    timestep_seconds: float
+
+
+class SceneStepClock:
+    """Count every successful ``scene.step()`` without changing call sites.
+
+    DOMINO already temporarily wraps ``scene.step`` in ``StepCounter`` during
+    planning.  Installing this lower-level wrapper keeps both counters valid:
+    the planning wrapper calls this one and restores it on exit.
+    """
+
+    def __init__(self, scene: Any):
+        self.scene = scene
+        self.step_index = 0
+        self.time_seconds = 0.0
+        self._original_step: Callable[[], Any] | None = None
+
+    @property
+    def installed(self) -> bool:
+        return self._original_step is not None
+
+    def install(self) -> None:
+        if self.installed:
+            raise RuntimeError("SceneStepClock is already installed")
+        self._original_step = self.scene.step
+
+        def counted_step():
+            assert self._original_step is not None
+            result = self._original_step()
+            timestep = float(self.scene.get_timestep())
+            self.step_index += 1
+            self.time_seconds += timestep
+            return result
+
+        self.scene.step = counted_step
+
+    def snapshot(self) -> SceneClockSnapshot:
+        return SceneClockSnapshot(
+            step_index=int(self.step_index),
+            time_seconds=float(self.time_seconds),
+            timestep_seconds=float(self.scene.get_timestep()),
+        )

+from __future__ import annotations
+
+import unittest
+
+from script.config_overrides import parse_override_pairs
+
+
+class TestConfigOverrides(unittest.TestCase):
+    def test_json_values_preserve_types_including_string_lookalikes(self):
+        parsed = parse_override_pairs(
+            [
+                "--enabled",
+                "false",
+                "--label",
+                '"false"',
+                "--dims",
+                "[6,13]",
+                "--threshold",
+                "0.15",
+                "--nothing",
+                "null",
+            ]
+        )
+        self.assertIs(parsed["enabled"], False)
+        self.assertEqual(parsed["label"], "false")
+        self.assertEqual(parsed["dims"], [6, 13])
+        self.assertEqual(parsed["threshold"], 0.15)
+        self.assertIsNone(parsed["nothing"])
+
+    def test_python_expression_is_data_not_executed(self):
+        expression = "__import__('os').system('false')"
+        self.assertEqual(
+            parse_override_pairs(["--value", expression]),
+            {"value": expression},
+        )
+
+    def test_malformed_or_duplicate_pairs_are_rejected(self):
+        with self.assertRaisesRegex(ValueError, "pairs"):
+            parse_override_pairs(["--one"])
+        with self.assertRaisesRegex(ValueError, "duplicate"):
+            parse_override_pairs(["--one", "1", "--one", "2"])
+        with self.assertRaisesRegex(ValueError, "start"):
+            parse_override_pairs(["one", "1"])
+
+
+if __name__ == "__main__":
+    unittest.main()

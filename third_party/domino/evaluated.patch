+    "first_target_gripper_contact_step_index",
+    "first_target_gripper_contact_time_seconds",
+    "first_target_gripper_contact_centroids_world",
+    "first_target_gripper_contact_point_counts",
+    "first_target_gripper_contact_ee_poses_wxyz",
+    "first_target_gripper_contact_target_poses_wxyz",
+    "stable_grasp_succeeded",
+)
+
+_IDENTITY_POSE = np.asarray([0, 0, 0, 1, 0, 0, 0], dtype=np.float64)
+
+
+def _require_shape(value: np.ndarray, shape: tuple[Optional[int], ...], field: str) -> None:
+    if value.ndim != len(shape):
+        raise ValueError(f"{field} must have rank {len(shape)}, got {value.shape}")
+    for axis, expected in enumerate(shape):
+        if expected is not None and int(value.shape[axis]) != int(expected):
+            raise ValueError(f"{field} must have shape {shape}, got {value.shape}")
+
+
+def _require_unit_quaternions(value: np.ndarray, field: str) -> None:
+    if value.size == 0:
+        return
+    norms = np.linalg.norm(value[..., 3:7].astype(np.float64), axis=-1)
+    if not np.isfinite(norms).all() or not np.allclose(norms, 1.0, atol=1e-3, rtol=1e-3):
+        raise ValueError(
+            f"{field} contains invalid wxyz quaternion norms "
+            f"[{float(np.min(norms)):.6g}, {float(np.max(norms)):.6g}]"
+        )
+
+
+def _validate_first_contact_latches(
+    payload: Dict[str, np.ndarray],
+    *,
+    sim_steps: np.ndarray,
+    sim_times: np.ndarray,
+    source: str,
+) -> None:
+    valid = payload["first_target_gripper_contact_valid"].astype(bool, copy=False)
+    event_steps = payload["first_target_gripper_contact_step_index"].astype(
+        np.int64, copy=False
+    )
+    event_times = payload["first_target_gripper_contact_time_seconds"].astype(
+        np.float64, copy=False
+    )
+    event_centroids = payload[
+        "first_target_gripper_contact_centroids_world"
+    ].astype(np.float64, copy=False)
+    event_counts = payload["first_target_gripper_contact_point_counts"].astype(
+        np.int64, copy=False
+    )
+    event_ee_poses = payload[
+        "first_target_gripper_contact_ee_poses_wxyz"
+    ].astype(np.float64, copy=False)
+    event_target_poses = payload[
+        "first_target_gripper_contact_target_poses_wxyz"
+    ].astype(np.float64, copy=False)
+
+    for arm_index, arm_name in enumerate(("left", "right")):
+        arm_valid = valid[:, arm_index]
+        if np.any(np.diff(arm_valid.astype(np.int8)) < 0):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact validity is not monotonic"
+            )
+
+        invalid = ~arm_valid
+        if np.any(event_steps[invalid, arm_index] != -1):
+            raise ValueError(
+                f"{source}: {arm_name} invalid first-contact steps must be -1"
+            )
+        if np.any(event_times[invalid, arm_index] != -1.0):
+            raise ValueError(
+                f"{source}: {arm_name} invalid first-contact times must be -1.0"
+            )
+        if np.any(event_counts[invalid, arm_index] != 0):
+            raise ValueError(
+                f"{source}: {arm_name} invalid first-contact point counts must be zero"
+            )
+        if invalid.any() and not np.allclose(
+            event_centroids[invalid, arm_index], 0.0, atol=1e-12, rtol=0
+        ):
+            raise ValueError(
+                f"{source}: {arm_name} invalid first-contact centroids must be zero"
+            )
+        if invalid.any():
+            invalid_ee = event_ee_poses[invalid, arm_index]
+            invalid_target = event_target_poses[invalid, arm_index]
+            if not np.allclose(invalid_ee, _IDENTITY_POSE, atol=1e-12, rtol=0):
+                raise ValueError(
+                    f"{source}: {arm_name} invalid first-contact EE poses must be identity"
+                )
+            if not np.allclose(invalid_target, _IDENTITY_POSE, atol=1e-12, rtol=0):
+                raise ValueError(
+                    f"{source}: {arm_name} invalid first-contact target poses must be identity"
+                )
+
+        valid_indices = np.flatnonzero(arm_valid)
+        if valid_indices.size == 0:
+            continue
+        first_index = int(valid_indices[0])
+        valid_steps = event_steps[first_index:, arm_index]
+        valid_times = event_times[first_index:, arm_index]
+        valid_centroids = event_centroids[first_index:, arm_index]
+        valid_counts = event_counts[first_index:, arm_index]
+        valid_ee = event_ee_poses[first_index:, arm_index]
+        valid_target = event_target_poses[first_index:, arm_index]
+        if valid_steps[0] < 0 or valid_times[0] < 0:
+            raise ValueError(
+                f"{source}: {arm_name} valid first-contact event has a negative step/time"
+            )
+        if valid_counts[0] <= 0:
+            raise ValueError(
+                f"{source}: {arm_name} valid first-contact event has no contact points"
+            )
+        if not np.all(valid_steps == valid_steps[0]):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact step changes after being latched"
+            )
+        if not np.allclose(valid_times, valid_times[0], atol=1e-12, rtol=0):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact time changes after being latched"
+            )
+        if not np.all(valid_counts == valid_counts[0]):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact point count changes after being latched"
+            )
+        if not np.allclose(valid_centroids, valid_centroids[0], atol=1e-12, rtol=0):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact centroid changes after being latched"
+            )
+        if not np.allclose(valid_ee, valid_ee[0], atol=1e-12, rtol=0):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact EE pose changes after being latched"
+            )
+        if not np.allclose(valid_target, valid_target[0], atol=1e-12, rtol=0):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact target pose changes after being latched"
+            )
+        if np.any(valid_steps > sim_steps[first_index:]):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact step is later than its saved frame"
+            )
+        if np.any(valid_times > sim_times[first_index:] + 1e-12):
+            raise ValueError(
+                f"{source}: {arm_name} first-contact time is later than its saved frame"
+            )
+
+
+def load_frame_synchronous_interception(
+    hdf5_path: str | Path,
+    *,
+    expected_frames: Optional[int] = None,
+    required: bool = True,
+) -> Optional[Dict[str, np.ndarray]]:
+    path = Path(hdf5_path)
+    with h5py.File(path, "r") as handle:
+        if "interception" not in handle:
+            if required:
+                raise ValueError(
+                    f"{path} has no frame-synchronous interception group; "
+                    "recollect the episode or explicitly allow legacy uniform resampling"
+                )
+            return None
+        group = handle["interception"]
+        missing = [field for field in INTERCEPTION_FIELDS if field not in group]
+        if missing:
+            raise ValueError(f"{path}:interception is missing fields: {missing}")
+        payload = {field: np.asarray(group[field][()]) for field in INTERCEPTION_FIELDS}
+
+    target_pose = payload["target_pose_wxyz"].astype(np.float64, copy=False)
+    _require_shape(target_pose, (None, 7), "target_pose_wxyz")
+    frame_count = int(target_pose.shape[0])
+    if frame_count <= 0:
+        raise ValueError(f"{path}:interception contains no frames")
+    if expected_frames is not None and frame_count != int(expected_frames):
+        raise ValueError(
+            f"{path}:interception has {frame_count} frames, expected {int(expected_frames)}"
+        )
+
+    for field in (
+        "schema_version",
+        "frame_index",
+        "sim_step_index",
+        "sim_time_seconds",
+        "sim_timestep_seconds",
+        "motion_start_sim_step_index",
+        "motion_start_sim_time_seconds",
+        "planned_intercept_sim_time_seconds",
+        "stable_grasp_succeeded",
+    ):
+        _require_shape(payload[field], (frame_count,), field)
+    _require_shape(payload["planned_intercept_position"], (frame_count, 3), "planned_intercept_position")
+    _require_shape(payload["target_contact_poses_wxyz"], (frame_count, None, 7), "target_contact_poses_wxyz")
+    _require_shape(payload["ee_poses_wxyz"], (frame_count, 2, 7), "ee_poses_wxyz")
+    _require_shape(payload["camera_poses_wxyz"], (frame_count, 3, 7), "camera_poses_wxyz")
+    _require_shape(payload["gripper_positions"], (frame_count, 2), "gripper_positions")
+    _require_shape(payload["target_gripper_contact_mask"], (frame_count, 2), "target_gripper_contact_mask")
+    _require_shape(payload["target_gripper_contact_centroids_world"], (frame_count, 2, 3), "target_gripper_contact_centroids_world")
+    _require_shape(payload["target_gripper_contact_point_counts"], (frame_count, 2), "target_gripper_contact_point_counts")
+    _require_shape(payload["first_target_gripper_contact_valid"], (frame_count, 2), "first_target_gripper_contact_valid")
+    _require_shape(payload["first_target_gripper_contact_step_index"], (frame_count, 2), "first_target_gripper_contact_step_index")
+    _require_shape(payload["first_target_gripper_contact_time_seconds"], (frame_count, 2), "first_target_gripper_contact_time_seconds")
+    _require_shape(payload["first_target_gripper_contact_centroids_world"], (frame_count, 2, 3), "first_target_gripper_contact_centroids_world")
+    _require_shape(payload["first_target_gripper_contact_point_counts"], (frame_count, 2), "first_target_gripper_contact_point_counts")
+    _require_shape(payload["first_target_gripper_contact_ee_poses_wxyz"], (frame_count, 2, 7), "first_target_gripper_contact_ee_poses_wxyz")
+    _require_shape(payload["first_target_gripper_contact_target_poses_wxyz"], (frame_count, 2, 7), "first_target_gripper_contact_target_poses_wxyz")
+
+    if not np.all(payload["schema_version"].astype(np.int64) == INTERCEPTION_SCHEMA_VERSION):
+        raise ValueError(f"{path}:interception has an unsupported schema version")
+    if not np.array_equal(payload["frame_index"].astype(np.int64), np.arange(frame_count)):
+        raise ValueError(f"{path}:interception frame_index is not contiguous 0..{frame_count - 1}")
+    sim_steps = payload["sim_step_index"].astype(np.int64)
+    sim_times = payload["sim_time_seconds"].astype(np.float64)
+    if np.any(np.diff(sim_steps) < 0):
+        raise ValueError(f"{path}:interception sim_step_index is not monotonic")
+    if np.any(np.diff(sim_times) < -1e-12):
+        raise ValueError(f"{path}:interception sim_time_seconds is not monotonic")
+    if np.any(payload["sim_timestep_seconds"].astype(np.float64) <= 0):
+        raise ValueError(f"{path}:interception has non-positive simulator timesteps")
+
+    for field in (
+        "sim_time_seconds",
+        "sim_timestep_seconds",
+        "motion_start_sim_time_seconds",
+        "planned_intercept_sim_time_seconds",
+        "planned_intercept_position",
+        "target_pose_wxyz",
+        "target_contact_poses_wxyz",
+        "ee_poses_wxyz",
+        "camera_poses_wxyz",
+        "gripper_positions",
+        "target_gripper_contact_centroids_world",
+        "first_target_gripper_contact_time_seconds",
+        "first_target_gripper_contact_centroids_world",
+        "first_target_gripper_contact_ee_poses_wxyz",
+        "first_target_gripper_contact_target_poses_wxyz",
+    ):
+        if not np.isfinite(payload[field]).all():
+            raise ValueError(f"{path}:interception field {field} contains non-finite values")
+    for field in (
+        "motion_start_sim_step_index",
+        "motion_start_sim_time_seconds",
+        "planned_intercept_sim_time_seconds",
+        "planned_intercept_position",
+    ):
+        if not np.allclose(payload[field], payload[field][0], atol=1e-10, rtol=1e-10):
+            raise ValueError(f"{path}:interception field {field} changes within the episode")
+
+    _require_unit_quaternions(target_pose, "target_pose_wxyz")
+    _require_unit_quaternions(payload["target_contact_poses_wxyz"], "target_contact_poses_wxyz")
+    _require_unit_quaternions(payload["ee_poses_wxyz"], "ee_poses_wxyz")
+    _require_unit_quaternions(payload["camera_poses_wxyz"], "camera_poses_wxyz")
+    _require_unit_quaternions(
+        payload["first_target_gripper_contact_ee_poses_wxyz"],
+        "first_target_gripper_contact_ee_poses_wxyz",
+    )
+    _require_unit_quaternions(
+        payload["first_target_gripper_contact_target_poses_wxyz"],
+        "first_target_gripper_contact_target_poses_wxyz",
+    )
+
+    contact_mask = payload["target_gripper_contact_mask"].astype(bool, copy=False)
+    contact_valid = payload["first_target_gripper_contact_valid"].astype(bool, copy=False)
+    contact_centroids = payload["target_gripper_contact_centroids_world"].astype(
+        np.float64, copy=False
+    )
+    contact_counts = payload["target_gripper_contact_point_counts"].astype(
+        np.int64, copy=False
+    )
+    if np.any(contact_counts < 0):
+        raise ValueError(f"{path}:interception has negative contact-point counts")
+    if not np.array_equal(contact_mask, contact_counts > 0):
+        raise ValueError(
+            f"{path}:interception contact mask does not match contact-point counts"
+        )
+    if np.any(~contact_mask) and not np.allclose(
+        contact_centroids[~contact_mask], 0.0, atol=1e-12, rtol=0
+    ):
+        raise ValueError(
+            f"{path}:interception invalid instantaneous contact centroids must be zero"
+        )
+    if np.any(contact_mask & ~contact_valid):
+        raise ValueError(
+            f"{path}:interception instantaneous contact exists without a latched first contact"
+        )
+    _validate_first_contact_latches(
+        payload,
+        sim_steps=sim_steps,
+        sim_times=sim_times,
+        source=f"{path}:interception",
+    )
+    stable_grasp = payload["stable_grasp_succeeded"].astype(bool, copy=False)
+    if np.any(np.diff(stable_grasp.astype(np.int8)) < 0):
+        raise ValueError(f"{path}:interception stable_grasp_succeeded is not monotonic")
+
+    payload["schema_version"] = payload["schema_version"].astype(np.int64, copy=False)
+    payload["frame_index"] = payload["frame_index"].astype(np.int64, copy=False)
+    payload["sim_step_index"] = sim_steps
+    payload["sim_time_seconds"] = sim_times
+    payload["target_pose_wxyz"] = target_pose
+    payload["target_gripper_contact_mask"] = contact_mask
+    payload["target_gripper_contact_centroids_world"] = contact_centroids
+    payload["target_gripper_contact_point_counts"] = contact_counts
+    payload["first_target_gripper_contact_valid"] = contact_valid
+    payload["first_target_gripper_contact_step_index"] = payload[
+        "first_target_gripper_contact_step_index"
+    ].astype(np.int64, copy=False)
+    payload["first_target_gripper_contact_time_seconds"] = payload[
+        "first_target_gripper_contact_time_seconds"
+    ].astype(np.float64, copy=False)
+    payload["first_target_gripper_contact_point_counts"] = payload[
+        "first_target_gripper_contact_point_counts"
+    ].astype(np.int64, copy=False)
+    payload["stable_grasp_succeeded"] = stable_grasp
+    return payload

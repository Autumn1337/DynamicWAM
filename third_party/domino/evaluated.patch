index 0000000..7a69233
--- /dev/null
+++ b/script/tests/test_pkl2hdf5_contract.py
@@ -0,0 +1,146 @@
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import pickle
+import sys
+import tempfile
+import types
+import unittest
+
+import h5py
+import numpy as np
+
+
+def load_module():
+    module_path = Path(__file__).resolve().parents[2] / "envs" / "utils" / "pkl2hdf5.py"
+    package_name = "pkl2hdf5_contract_testpkg"
+    package = types.ModuleType(package_name)
+    package.__path__ = [str(module_path.parent)]
+    sys.modules[package_name] = package
+
+    video_module = types.ModuleType(f"{package_name}.images_to_video")
+
+    def images_to_video(_images, out_path):
+        Path(out_path).write_bytes(b"test-video")
+
+    video_module.images_to_video = images_to_video
+    sys.modules[video_module.__name__] = video_module
+    spec = importlib.util.spec_from_file_location(
+        f"{package_name}.pkl2hdf5",
+        module_path,
+    )
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+PKL2HDF5 = load_module()
+
+
+def interception_frame(frame_index: int) -> dict:
+    identity = np.asarray([0, 0, 0, 1, 0, 0, 0], dtype=np.float64)
+    return {
+        "schema_version": np.int64(2),
+        "frame_index": np.int64(frame_index),
+        "sim_step_index": np.int64(frame_index * 3),
+        "sim_time_seconds": np.float64(frame_index * 0.03),
+        "sim_timestep_seconds": np.float64(0.01),
+        "motion_start_sim_step_index": np.int64(0),
+        "motion_start_sim_time_seconds": np.float64(0.0),
+        "planned_intercept_sim_time_seconds": np.float64(0.2),
+        "planned_intercept_position": np.asarray([0.1, 0.2, 0.3], dtype=np.float64),
+        "target_pose_wxyz": identity.copy(),
+        "target_contact_poses_wxyz": identity[None].copy(),
+        "ee_poses_wxyz": np.tile(identity, (2, 1)),
+        "camera_poses_wxyz": np.tile(identity, (3, 1)),
+        "gripper_positions": np.zeros(2, dtype=np.float64),
+        "target_gripper_contact_mask": np.zeros(2, dtype=bool),
+        "target_gripper_contact_centroids_world": np.zeros((2, 3), dtype=np.float64),
+        "target_gripper_contact_point_counts": np.zeros(2, dtype=np.int64),
+        "first_target_gripper_contact_valid": np.zeros(2, dtype=bool),
+        "first_target_gripper_contact_step_index": np.full(2, -1, dtype=np.int64),
+        "first_target_gripper_contact_time_seconds": np.full(2, -1.0, dtype=np.float64),
+        "first_target_gripper_contact_centroids_world": np.zeros((2, 3), dtype=np.float64),
+        "first_target_gripper_contact_point_counts": np.zeros(2, dtype=np.int64),
+        "first_target_gripper_contact_ee_poses_wxyz": np.tile(identity, (2, 1)),
+        "first_target_gripper_contact_target_poses_wxyz": np.tile(identity, (2, 1)),
+        "stable_grasp_succeeded": np.bool_(False),
+    }
+
+
+class TestPklToHdf5Contract(unittest.TestCase):
+    def test_missing_frame_field_fails_immediately(self) -> None:
+        structure = {"a": [], "nested": {"b": []}}
+        with self.assertRaisesRegex(KeyError, "nested/b"):
+            PKL2HDF5.append_data_to_structure(
+                structure,
+                {"a": np.array([1]), "nested": {}},
+            )
+
+    def test_serializes_equal_length_interception_fields_atomically(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            pkl_paths = []
+            for frame_index in range(2):
+                frame = {
+                    "observation": {
+                        "head_camera": {
+                            "rgb": np.zeros((4, 4, 3), dtype=np.uint8),
+                        }
+                    },
+                    "interception": {
+                        **interception_frame(frame_index),
+                    },
+                }
+                pkl_path = root / f"{frame_index}.pkl"
+                with pkl_path.open("wb") as handle:
+                    pickle.dump(frame, handle)
+                pkl_paths.append(str(pkl_path))
+
+            hdf5_path = root / "episode0.hdf5"
+            video_path = root / "episode0.mp4"
+            PKL2HDF5.pkl_files_to_hdf5_and_video(
+                pkl_paths,
+                hdf5_path,
+                video_path,
+            )
+
+            with h5py.File(hdf5_path, "r") as handle:
+                self.assertEqual(handle["interception/frame_index"].shape, (2,))
+                self.assertEqual(
+                    handle["interception/target_pose_wxyz"].shape,
+                    (2, 7),
+                )
+            self.assertTrue(video_path.exists())
+            self.assertFalse(list(root.glob("*.tmp.*")))
+
+    def test_rejects_legacy_interception_schema(self) -> None:
+        frames = [interception_frame(0), interception_frame(1)]
+        frames[0]["schema_version"] = np.int64(1)
+        structure = {"interception": {key: [] for key in frames[0]}}
+        for frame in frames:
+            PKL2HDF5.append_data_to_structure(
+                structure,
+                {"interception": frame},
+            )
+        with self.assertRaisesRegex(ValueError, "Unsupported interception schema"):
+            PKL2HDF5.validate_interception_frames(structure, 2)
+
+    def test_hdf5_jpeg_preserves_rgb_color_semantics(self) -> None:
+        rgb_red = np.zeros((16, 16, 3), dtype=np.uint8)
+        rgb_red[..., 0] = 255
+        encoded, _max_len = PKL2HDF5.images_encoding([rgb_red], is_rgb=True)
+        decoded_bgr = PKL2HDF5.cv2.imdecode(
+            np.frombuffer(encoded[0], dtype=np.uint8),
+            PKL2HDF5.cv2.IMREAD_COLOR,
+        )
+        center = decoded_bgr[8, 8]
+        self.assertGreater(int(center[2]), 240)
+        self.assertLess(int(center[0]), 15)
+
+
+if __name__ == "__main__":
+    unittest.main()

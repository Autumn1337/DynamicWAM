+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+import h5py
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from interception_hdf5 import (  # noqa: E402
+    INTERCEPTION_FIELDS,
+    load_frame_synchronous_interception,
+)
+
+
+def payload(frame_count: int = 4):
+    identity = np.array([0, 0, 0, 1, 0, 0, 0], dtype=np.float64)
+    if frame_count < 3:
+        raise ValueError("test payload requires at least three frames")
+    event_valid = np.zeros((frame_count, 2), dtype=bool)
+    event_valid[2:, 0] = True
+    event_steps = np.full((frame_count, 2), -1, dtype=np.int64)
+    event_steps[2:, 0] = 18
+    event_times = np.full((frame_count, 2), -1.0, dtype=np.float64)
+    event_times[2:, 0] = 1.08
+    event_centroids = np.zeros((frame_count, 2, 3), dtype=np.float64)
+    event_centroids[2:, 0] = [0.1, 0.2, 0.3]
+    event_counts = np.zeros((frame_count, 2), dtype=np.int64)
+    event_counts[2:, 0] = 2
+    event_ee = np.tile(identity, (frame_count, 2, 1))
+    event_ee[2:, 0, 0] = 0.1
+    event_target = np.tile(identity, (frame_count, 2, 1))
+    event_target[2:, 0, 1] = 0.2
+    contact_mask = np.zeros((frame_count, 2), dtype=bool)
+    contact_mask[2, 0] = True
+    contact_centroids = np.zeros((frame_count, 2, 3), dtype=np.float64)
+    contact_centroids[2, 0] = [0.1, 0.2, 0.3]
+    contact_counts = np.zeros((frame_count, 2), dtype=np.int64)
+    contact_counts[2, 0] = 2
+    return {
+        "schema_version": np.full(frame_count, 2, dtype=np.int64),
+        "frame_index": np.arange(frame_count, dtype=np.int64),
+        "sim_step_index": np.arange(frame_count, dtype=np.int64) * 4 + 10,
+        "sim_time_seconds": np.arange(frame_count, dtype=np.float64) * 0.04 + 1.0,
+        "sim_timestep_seconds": np.full(frame_count, 0.01, dtype=np.float64),
+        "motion_start_sim_step_index": np.full(frame_count, 10, dtype=np.int64),
+        "motion_start_sim_time_seconds": np.full(frame_count, 1.0, dtype=np.float64),
+        "planned_intercept_sim_time_seconds": np.full(frame_count, 1.2, dtype=np.float64),
+        "planned_intercept_position": np.tile([0.1, 0.2, 0.3], (frame_count, 1)),
+        "target_pose_wxyz": np.tile(identity, (frame_count, 1)),
+        "target_contact_poses_wxyz": np.tile(identity, (frame_count, 2, 1)),
+        "ee_poses_wxyz": np.tile(identity, (frame_count, 2, 1)),
+        "camera_poses_wxyz": np.tile(identity, (frame_count, 3, 1)),
+        "gripper_positions": np.zeros((frame_count, 2), dtype=np.float64),
+        "target_gripper_contact_mask": contact_mask,
+        "target_gripper_contact_centroids_world": contact_centroids,
+        "target_gripper_contact_point_counts": contact_counts,
+        "first_target_gripper_contact_valid": event_valid,
+        "first_target_gripper_contact_step_index": event_steps,
+        "first_target_gripper_contact_time_seconds": event_times,
+        "first_target_gripper_contact_centroids_world": event_centroids,
+        "first_target_gripper_contact_point_counts": event_counts,
+        "first_target_gripper_contact_ee_poses_wxyz": event_ee,
+        "first_target_gripper_contact_target_poses_wxyz": event_target,
+        "stable_grasp_succeeded": np.arange(frame_count) == frame_count - 1,
+    }
+
+
+class TestInterceptionHdf5(unittest.TestCase):
+    def _write(self, root: Path, values) -> Path:
+        path = root / "episode0.hdf5"
+        with h5py.File(path, "w") as handle:
+            group = handle.create_group("interception")
+            for field in INTERCEPTION_FIELDS:
+                group.create_dataset(field, data=values[field])
+        return path
+
+    def test_loads_valid_exact_frame_metadata(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            path = self._write(Path(tmp), payload())
+            result = load_frame_synchronous_interception(path, expected_frames=4)
+        self.assertIsNotNone(result)
+        self.assertEqual(result["target_contact_poses_wxyz"].shape, (4, 2, 7))
+
+    def test_rejects_timestamp_regression(self) -> None:
+        values = payload()
+        values["sim_time_seconds"][2] = 0.5
+        with tempfile.TemporaryDirectory() as tmp:
+            path = self._write(Path(tmp), values)
+            with self.assertRaisesRegex(ValueError, "not monotonic"):
+                load_frame_synchronous_interception(path)
+
+    def test_rejects_first_contact_latch_regression(self) -> None:
+        values = payload()
+        values["first_target_gripper_contact_valid"][3, 0] = False
+        with tempfile.TemporaryDirectory() as tmp:
+            path = self._write(Path(tmp), values)
+            with self.assertRaisesRegex(ValueError, "validity is not monotonic"):
+                load_frame_synchronous_interception(path)
+
+    def test_rejects_first_contact_from_future_frame(self) -> None:
+        values = payload()
+        values["first_target_gripper_contact_step_index"][2:, 0] = 21
+        with tempfile.TemporaryDirectory() as tmp:
+            path = self._write(Path(tmp), values)
+            with self.assertRaisesRegex(ValueError, "later than its saved frame"):
+                load_frame_synchronous_interception(path)
+
+    def test_missing_group_is_only_allowed_explicitly(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "episode0.hdf5"
+            with h5py.File(path, "w"):
+                pass
+            self.assertIsNone(
+                load_frame_synchronous_interception(path, required=False)
+            )
+            with self.assertRaisesRegex(ValueError, "recollect"):
+                load_frame_synchronous_interception(path, required=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/script/tests/test_pkl2hdf5_contract.py b/script/tests/test_pkl2hdf5_contract.py

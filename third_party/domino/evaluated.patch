new file mode 100644
index 0000000..510e7cd
--- /dev/null
+++ b/script/config_overrides.py
@@ -0,0 +1,39 @@
+"""Typed, non-executable parsing for DOMINO CLI config overrides."""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Sequence
+
+import yaml
+
+
+_KEY_PATTERN = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+
+
+def parse_override_value(raw: str) -> Any:
+    """Parse one JSON/YAML scalar or collection without executing code."""
+    try:
+        return yaml.safe_load(raw)
+    except yaml.YAMLError as exc:
+        raise ValueError(f"invalid override value {raw!r}") from exc
+
+
+def parse_override_pairs(pairs: Sequence[str]) -> dict[str, Any]:
+    if len(pairs) % 2:
+        raise ValueError(
+            "override arguments must be --key value pairs; "
+            f"received {len(pairs)} tokens"
+        )
+    overrides: dict[str, Any] = {}
+    for index in range(0, len(pairs), 2):
+        raw_key = pairs[index]
+        if not raw_key.startswith("--"):
+            raise ValueError(f"override key must start with '--': {raw_key!r}")
+        key = raw_key[2:]
+        if _KEY_PATTERN.fullmatch(key) is None:
+            raise ValueError(f"invalid override key: {raw_key!r}")
+        if key in overrides:
+            raise ValueError(f"duplicate override key: {key!r}")
+        overrides[key] = parse_override_value(pairs[index + 1])
+    return overrides

+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+
+MODULE_PATH = (
+    Path(__file__).resolve().parents[2]
+    / "description"
+    / "utils"
+    / "generate_episode_instructions.py"
+)
+SPEC = importlib.util.spec_from_file_location(
+    "generate_episode_instructions",
+    MODULE_PATH,
+)
+assert SPEC is not None and SPEC.loader is not None
+instructions = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(instructions)
+
+
+class TestEpisodeInstructionPaths(unittest.TestCase):
+    def test_save_uses_configured_collection_root(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            instructions.save_episode_descriptions(
+                "adjust_bottle",
+                "interception_v2_smoke",
+                [
+                    {
+                        "episode_index": 0,
+                        "seen": ["Lift the bottle upright."],
+                        "unseen": [],
+                    }
+                ],
+                str(root),
+            )
+            output = (
+                root
+                / "adjust_bottle"
+                / "interception_v2_smoke"
+                / "instructions"
+                / "episode0.json"
+            )
+            self.assertTrue(output.is_file())
+            self.assertEqual(
+                json.loads(output.read_text(encoding="utf-8"))["seen"],
+                ["Lift the bottle upright."],
+            )
+
+    def test_load_uses_same_configured_collection_root(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            scene_dir = root / "adjust_bottle" / "interception_v2_smoke"
+            scene_dir.mkdir(parents=True)
+            expected = {"episode_0": {"info": {"{A}": "bottle"}}}
+            (scene_dir / "scene_info.json").write_text(
+                json.dumps(expected),
+                encoding="utf-8",
+            )
+            actual = instructions.load_scene_info(
+                "adjust_bottle",
+                "interception_v2_smoke",
+                str(root),
+            )
+            self.assertEqual(actual, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()

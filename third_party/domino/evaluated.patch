+from __future__ import annotations
+
+from pathlib import Path
+import sys
+import unittest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "envs" / "utils"))
+
+from frame_sync import SceneStepClock  # noqa: E402
+
+
+class FakeScene:
+    def __init__(self):
+        self.calls = 0
+        self.timestep = 0.01
+
+    def step(self):
+        self.calls += 1
+
+    def get_timestep(self):
+        return self.timestep
+
+
+class TestSceneStepClock(unittest.TestCase):
+    def test_counts_all_wrapped_scene_steps_and_accumulates_time(self) -> None:
+        scene = FakeScene()
+        clock = SceneStepClock(scene)
+        clock.install()
+        scene.step()
+        scene.step()
+        scene.timestep = 0.02
+        scene.step()
+        snapshot = clock.snapshot()
+        self.assertEqual(scene.calls, 3)
+        self.assertEqual(snapshot.step_index, 3)
+        self.assertAlmostEqual(snapshot.time_seconds, 0.04)
+        self.assertAlmostEqual(snapshot.timestep_seconds, 0.02)
+
+    def test_composes_with_a_temporary_outer_step_wrapper(self) -> None:
+        scene = FakeScene()
+        clock = SceneStepClock(scene)
+        clock.install()
+        clock_step = scene.step
+        outer_count = 0
+
+        def outer_step():
+            nonlocal outer_count
+            outer_count += 1
+            clock_step()
+
+        scene.step = outer_step
+        scene.step()
+        scene.step = clock_step
+        scene.step()
+        self.assertEqual(outer_count, 1)
+        self.assertEqual(clock.snapshot().step_index, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()

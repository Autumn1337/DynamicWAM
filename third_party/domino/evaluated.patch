+    def _camera_poses_from_observation(self, observation: dict) -> np.ndarray:
+        """Return OpenCV-camera-to-world poses in the fixed model order."""
+        camera_order = ("head_camera", "left_camera", "right_camera")
+        missing = [name for name in camera_order if name not in observation]
+        if missing:
+            raise RuntimeError(
+                "Interception v2 capture requires head and both wrist cameras; "
+                f"missing {missing}"
+            )
+        poses = []
+        for camera_name in camera_order:
+            camera_data = observation[camera_name]
+            if "extrinsic_cv" not in camera_data:
+                raise RuntimeError(
+                    f"Interception v2 capture requires {camera_name}.extrinsic_cv"
+                )
+            world_to_camera_cv = np.asarray(camera_data["extrinsic_cv"], dtype=np.float64)
+            if world_to_camera_cv.shape == (3, 4):
+                world_to_camera_cv = np.vstack(
+                    [world_to_camera_cv, np.asarray([0.0, 0.0, 0.0, 1.0])]
+                )
+            if (
+                world_to_camera_cv.shape != (4, 4)
+                or not np.isfinite(world_to_camera_cv).all()
+                or not np.allclose(
+                    world_to_camera_cv[3],
+                    np.asarray([0.0, 0.0, 0.0, 1.0]),
+                    atol=1e-8,
+                    rtol=0,
+                )
+            ):
+                raise ValueError(
+                    f"{camera_name}.extrinsic_cv must be a finite 3x4 or homogeneous 4x4 transform"
+                )
+            camera_to_world_cv = np.linalg.inv(world_to_camera_cv)
+            poses.append(
+                self._matrix_to_pose7(
+                    camera_to_world_cv,
+                    field=f"{camera_name}.camera_to_world_cv",
+                )
+            )
+        return np.stack(poses, axis=0)
